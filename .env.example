# AI for ICP generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_PROVIDER=openai

# Lead engine (server-side only — never shown in UI)
APIFY_TOKEN=

# LinkedIn scraper (default)
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-profile-search

# LinkedIn + email scraper (used when "Find emails" is enabled)
APIFY_LINKEDIN_EMAIL_ACTOR=harvestapi/linkedin-profile-search

# Google Maps scraper
APIFY_MAPS_ACTOR=compass/crawler-google-places
